    "@org/test-drivers": "workspace:^",
    "@playwright/test": "^1.61.1",
    "@types/node": "^25.9.4",
    "@types/pg": "^8.20.0",
    "dotenv": "^16.6.1",
    "pg": "^8.20.0",
    "typescript": "^5.9.3"
  }
}
