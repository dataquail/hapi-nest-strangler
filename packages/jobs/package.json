{
  "name": "@org/jobs",
  "version": "0.0.0",
  "type": "module",
  "license": "MIT",
  "description": "Background jobs (cron-style) for the nest-monorepo deployment.",
  "scripts": {
    "check": "tsc -b tsconfig.json",
    "test": "vitest",
    "clean": "rm -rf build .tsbuildinfo",
    "build": "tsc -b tsconfig.build.json",
    "dev": "tsx watch src/main.ts",
    "start:dev": "tsx src/main.ts",
    "start": "node build/esm/main.js"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.0",
    "@org/database": "workspace:^",
    "croner": "^10.0.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^25.9.4",
    "dotenv": "^17.4.2",
    "tsx": "^4.23.0"
  }
}
