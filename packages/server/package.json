{
  "name": "@org/server",
  "version": "0.0.0",
  "type": "module",
  "license": "MIT",
  "description": "The NestJS server: hexagonal feature modules over @nestjs/cqrs, one domain event bus and a hand-rolled unit of work. Owns the wallet; reached by the legacy API over HTTP.",
  "scripts": {
    "check": "tsc -b tsconfig.json",
    "test": "vitest",
    "build": "tsc -b tsconfig.build.json",
    "predev": "lsof -ti:3001 | xargs kill -9 2>/dev/null; true",
    "dev": "tsx watch --tsconfig tsconfig.src.json --import ./src/instrumentation.ts src/main.ts",
    "start": "tsx --tsconfig tsconfig.src.json --import ./src/instrumentation.ts src/main.ts"
  },
  "dependencies": {
    "@nestjs/common": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/cqrs": "^12.0.0",
    "@nestjs/platform-express": "^12.0.1",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/auto-instrumentations-node": "^0.80.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.222.0",
    "@opentelemetry/sdk-node": "^0.222.0",
    "@org/authz": "workspace:^",
    "@org/contracts": "workspace:^",
    "@org/database": "workspace:^",
    "@org/event-bus": "workspace:^",
    "@org/unit-of-work": "workspace:^",
    "cookie": "^2.0.1",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jose": "^6.2.12",
    "oxide.ts": "^1.1.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@nestjs/testing": "^12.0.1",
    "@types/express": "^5.0.6",
    "openapi-fetch": "^0.17.0",
    "tsx": "^4.23.0"
  }
}
